# Frontend API base URL — uses relative path so Vite proxies /api/* to port 4000.
# Do NOT change this to an absolute URL unless deploying without the proxy.
VITE_API_BASE=/api

# ── Express API Server ──────────────────────────────────────────────────────────
PORT=4000
DB_PATH=./server/accessne.db

# JWT secret — keep this stable; changing it invalidates all issued tokens.
JWT_SECRET=accessne-dev-secret-replace-before-deploy
JWT_EXPIRES_IN=7d
GUEST_TOKEN_EXPIRES_IN=24h

NODE_ENV=development
